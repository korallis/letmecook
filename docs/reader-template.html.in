<!doctype html>
<!-- Generated by build-reader.ts from Markdown; edit sources, then run npm --prefix docs run build. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Gaffer: researched product requirements, technical design and a gated delivery plan for self-hosted coding-agent coordination.">
<title>Gaffer — evaluated build plan</title>
<link rel="icon" href="data:,">
<style>
:root{
  --stock:#E2E5DF; --surface:#F0F2EE; --ink:#16211F; --ink-2:#4A5754;
  --ink-3:#6E7A76; --oxide:#9E3B22; --oxide-soft:#C9714F; --rule:#C2C8C1;
  --sans:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --serif:"Newsreader",Georgia,"Times New Roman",serif;
  --measure:68ch;
}
@media (prefers-color-scheme:dark){
  :root{
    --stock:#141A18; --surface:#1B2321; --ink:#DFE4DF; --ink-2:#A6B0AC;
    --ink-3:#7E8985; --oxide:#D9724F; --oxide-soft:#B05B3C; --rule:#2E3A36;
  }
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:1.5rem}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{
  margin:0;background:var(--stock);color:var(--ink);
  font-family:var(--serif);font-size:17px;line-height:1.62;
  -webkit-font-smoothing:antialiased;
}

/* ── layout ─────────────────────────────────────────── */
.shell{display:grid;grid-template-columns:262px minmax(0,1fr);min-height:100vh}
.rail{
  border-right:1px solid var(--rule);padding:1.6rem 1.1rem 3rem;
  position:sticky;top:0;height:100vh;overflow-y:auto;
}
.main{padding:0 clamp(1.1rem,4vw,3.4rem) 7rem;min-width:0}

/* ── rail ───────────────────────────────────────────── */
.brand{font-family:var(--sans);margin-bottom:.3rem}
.brand b{font-weight:600;font-size:1.02rem;letter-spacing:-.01em;display:block}
.brand span{font-size:.72rem;color:var(--ink-3);display:block;line-height:1.45;margin-top:.3rem}
.rail hr{border:0;border-top:1px solid var(--rule);margin:1.2rem 0}
.navdoc{margin-bottom:1.15rem}
.navtitle{
  font-family:var(--sans);font-size:.82rem;font-weight:600;color:var(--ink);
  text-decoration:none;display:block;padding:.18rem 0;
}
.navtitle em{display:block;font-style:normal;font-weight:400;font-size:.68rem;color:var(--ink-3);margin-top:.1rem}
.navtitle:hover{color:var(--oxide)}
.navlist{list-style:none;margin:.45rem 0 0;padding:0;border-left:1px solid var(--rule)}
.navlist a{
  font-family:var(--sans);font-size:.71rem;line-height:1.35;color:var(--ink-2);
  text-decoration:none;display:block;padding:.2rem 0 .2rem .7rem;margin-left:-1px;
  border-left:1px solid transparent;
}
.navlist a:hover{color:var(--ink);border-left-color:var(--oxide-soft)}
.navlist a.here{color:var(--oxide);border-left-color:var(--oxide);font-weight:500}
.navlist .lvl3 a{padding-left:1.35rem;font-size:.685rem;color:var(--ink-3)}
.railtoggle{display:none}

/* ── hero ───────────────────────────────────────────── */
.hero{padding:3.2rem 0 2.4rem;max-width:var(--measure)}
.hero h1{
  font-family:var(--serif);font-weight:500;font-size:clamp(2.3rem,5.5vw,3.5rem);
  line-height:1.03;letter-spacing:-.02em;margin:0 0 .9rem;
}
.hero p{font-size:1.12rem;color:var(--ink-2);margin:0 0 .5rem;max-width:56ch}
.hero .meta{font-family:var(--sans);font-size:.72rem;color:var(--ink-3);margin-top:1.4rem}

.board{
  margin:2.2rem 0 0;border:1px solid var(--rule);background:var(--surface);
  font-family:var(--sans);font-size:.735rem;overflow-x:auto;max-width:860px;
}
.board .cap{
  padding:.55rem .85rem;border-bottom:1px solid var(--rule);
  color:var(--ink-3);font-size:.68rem;
}
.row{
  display:grid;grid-template-columns:6.2rem minmax(13rem,1fr) 6.4rem 8.6rem 6.4rem;
  gap:.7rem;align-items:center;padding:.52rem .85rem;
  border-bottom:1px solid var(--rule);min-width:640px;
}
.row:last-child{border-bottom:0}
.row.coord{background:color-mix(in srgb,var(--oxide) 7%,transparent)}
.tid{font-weight:600;color:var(--ink)}
.intent{color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.machine,.harness{color:var(--ink-3);font-size:.685rem}
.state{
  font-size:.66rem;padding:.12rem .42rem;border:1px solid var(--rule);
  color:var(--ink-2);text-align:center;white-space:nowrap;
  opacity:0;animation:chip .32s ease forwards;animation-delay:calc(.35s + var(--i)*.13s);
}
@keyframes chip{from{opacity:0;transform:translateY(-2px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.state{opacity:1;animation:none}}
.s-merged{border-color:var(--ink-2);color:var(--ink)}
.s-review{border-color:var(--oxide);color:var(--oxide);font-weight:500}
.s-running{border-color:var(--oxide-soft);color:var(--oxide-soft)}
.s-blocked{border-style:dashed;color:var(--ink-3)}
.s-queued{color:var(--ink-3);border-color:var(--rule)}
.machines{
  display:flex;flex-wrap:wrap;gap:.3rem .95rem;padding:.6rem .85rem;
  border-top:1px solid var(--rule);font-size:.665rem;color:var(--ink-3);
}
.machines b{font-weight:600;color:var(--ink-2)}
.capture{
  margin:1.9rem 0 0;border:1px solid var(--rule);background:var(--surface);
  font-family:var(--sans);font-size:.735rem;line-height:1.5;padding:.85rem;
  display:grid;grid-template-columns:auto auto 1fr;gap:.75rem;align-items:start;
  max-width:860px;
}
.cbox{border:1px solid var(--ink-3);padding:.3rem .55rem;color:var(--ink);white-space:nowrap}
.carrow{color:var(--oxide);padding-top:.3rem}
.cbrief{color:var(--ink-2);padding-top:.3rem}
.cbrief b{color:var(--oxide);font-weight:600}
.cbrief code{font-size:.95em}
.cbrief em{font-style:normal;color:var(--ink-3)}
@media (max-width:640px){.capture{grid-template-columns:1fr;gap:.4rem}.carrow{display:none}}
.machines .res b{color:var(--oxide)}
.machines .res{color:var(--oxide-soft)}
.s-thinking{border-color:var(--oxide);color:var(--oxide)}

/* ── document type ──────────────────────────────────── */
.doc{max-width:var(--measure);padding-top:2.6rem}
.doc+.doc{border-top:1px solid var(--rule);margin-top:3.2rem}
.doc h1{
  font-weight:600;font-size:2rem;line-height:1.12;letter-spacing:-.015em;
  margin:0 0 1.1rem;
}
.doc h2{
  font-family:var(--sans);font-weight:600;font-size:.94rem;letter-spacing:-.005em;
  margin:3rem 0 .9rem;padding-bottom:.4rem;border-bottom:1px solid var(--rule);
}
.doc h3{font-weight:600;font-size:1.34rem;margin:2.3rem 0 .6rem;letter-spacing:-.01em}
.doc h4{font-weight:600;font-size:1.08rem;margin:2rem 0 .5rem}
.doc h4.story{
  margin-top:2.6rem;padding-top:1.1rem;border-top:1px solid var(--rule);
  display:flex;gap:.7rem;align-items:baseline;flex-wrap:wrap;
}
.uscode{
  font-family:var(--sans);font-size:.7rem;font-weight:600;color:var(--oxide);
  border:1px solid var(--oxide);padding:.08rem .36rem;flex:none;
}
.doc h5,.doc h6{font-family:var(--sans);font-size:.78rem;font-weight:600;margin:1.4rem 0 .4rem}
.doc p{margin:0 0 1.05rem}
.doc strong{font-weight:600}
.doc em{font-style:italic;color:var(--ink-2)}
.doc a{color:var(--oxide);text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:.5px}
.doc a:hover{background:color-mix(in srgb,var(--oxide) 12%,transparent)}
.doc hr{border:0;border-top:1px solid var(--rule);margin:2.6rem 0}
.doc ul,.doc ol{margin:0 0 1.05rem;padding-left:1.25rem}
.doc li{margin-bottom:.34rem}
.doc blockquote{
  margin:1.4rem 0;padding:.1rem 0 .1rem 1.1rem;border-left:2px solid var(--oxide-soft);
  color:var(--ink-2);font-style:italic;
}
.doc blockquote p:last-child{margin-bottom:0}
.doc code{
  font-family:var(--sans);font-size:.82em;background:var(--surface);
  border:1px solid var(--rule);padding:.05em .3em;
}
.doc pre{
  font-family:var(--sans);background:var(--surface);border:1px solid var(--rule);
  padding:.95rem 1.05rem;overflow-x:auto;font-size:.755rem;line-height:1.52;
  margin:0 0 1.35rem;
}
.doc pre code{background:none;border:0;padding:0;font-size:inherit}
.doc table{
  border-collapse:collapse;width:100%;margin:0 0 1.4rem;
  font-family:var(--sans);font-size:.755rem;
}
.doc th{
  text-align:left;font-weight:600;padding:.5rem .6rem;
  border-bottom:1px solid var(--ink-2);vertical-align:bottom;
}
.doc td{padding:.5rem .6rem;border-bottom:1px solid var(--rule);vertical-align:top;color:var(--ink-2)}
.doc tr td:first-child{color:var(--ink)}

/* checklists */
.doc ul.checklist{list-style:none;padding-left:0}
.doc li.check{
  position:relative;padding-left:1.5rem;font-family:var(--sans);
  font-size:.79rem;line-height:1.5;margin-bottom:.5rem;color:var(--ink-2);
}
.doc li.check .box{
  position:absolute;left:0;top:.3em;width:.72rem;height:.72rem;
  border:1px solid var(--ink-3);
}
.doc li.check.done .box{background:var(--oxide);border-color:var(--oxide)}

/* ── responsive ─────────────────────────────────────── */
@media (max-width:900px){
  .shell{grid-template-columns:1fr}
  .rail{
    position:static;height:auto;border-right:0;border-bottom:1px solid var(--rule);
    padding:1.1rem 1.1rem 1.3rem;
  }
  .railtoggle{
    display:block;font-family:var(--sans);font-size:.74rem;background:none;
    border:1px solid var(--rule);color:var(--ink-2);padding:.32rem .6rem;
    margin-top:.9rem;cursor:pointer;
  }
  .railnav{display:none}
  .railnav.open{display:block;margin-top:1rem}
  .hero{padding:2.2rem 0 1.6rem}
  .doc{padding-top:2rem}
  body{font-size:16.5px}
}
a:focus-visible,button:focus-visible{outline:2px solid var(--oxide);outline-offset:2px}

.table-wrap{overflow-x:auto;margin-bottom:1.4rem}
.table-wrap table{min-width:36rem;margin-bottom:0}
.doc{overflow-wrap:anywhere}
.doc pre{overflow-wrap:normal}
.doc li input[type="checkbox"]{margin-right:.5rem;accent-color:var(--oxide)}
.railnav{display:block}
.reader-ready .railnav{display:none}
@media(min-width:901px){.reader-ready .railnav{display:block}}
.reader-ready .railnav.open{display:block}
.doc h2,.doc h3{scroll-margin-top:1.5rem}
.skip-link{position:absolute;top:-10rem;left:1rem;z-index:10;background:var(--surface);padding:.5rem}
.skip-link:focus{top:1rem}
@media print{.rail,.railtoggle,.board,.capture{display:none}.shell{display:block}.main{padding:0}.doc{max-width:none}.doc+.doc{break-before:page}.table-wrap{overflow:visible}.table-wrap table{min-width:0}}
</style>
</head>
<body id="top">
<a class="skip-link" href="#readme">Skip to documents</a>
<div class="shell">
  <aside class="rail" aria-label="Documentation navigation">
    <div class="brand"><b>Gaffer</b><span>A foreman for your coding agents.<br>Proposed baseline v0.4.</span></div>
    <button class="railtoggle" aria-expanded="false" aria-controls="reader-navigation">Contents</button>
    <nav class="railnav" id="reader-navigation" aria-label="Contents"><hr>{{NAV}}</nav>
  </aside>
  <main class="main">
    <header class="hero">
      <h1>Keep the intent.<br>Deliver the work.</h1>
      <p>Capture an idea. Agree what done means. Keep authorised work moving on your machines, and return to verified changes you can review.</p>
      <p>A self-hosted coding-agent coordinator, with an operator-configured model gateway owning provider access across the whole crew.</p>
      <div class="capture" aria-label="Illustrative capture and brief">
        <span class="cbox">tidy up the auth module</span>
        <span class="carrow" aria-hidden="true">→</span>
        <span class="cbrief"><b>proposed brief</b> remove dead code, pass lint, preserve behaviour<br><b>confirm</b> server auth only <em>· awaiting your approval</em></span>
      </div>
      <div class="meta">Six documents · evidence, requirements, design and delivery gates<br>Proposed features, not implemented behaviour</div>
    </header>
    {{ARTICLES}}
  </main>
</div>
<script>
(() => {
  const toggle = document.querySelector('.railtoggle');
  const nav = document.querySelector('.railnav');
  document.documentElement.classList.add('reader-ready');
  toggle.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  nav.addEventListener('click', event => {
    if (event.target.closest('a') && innerWidth <= 900) {
      nav.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
  const links = new Map([...document.querySelectorAll('.navlist a')].map(a => [a.hash.slice(1), a]));
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      for (const link of links.values()) { link.classList.remove('here'); link.removeAttribute('aria-current'); }
      const link = links.get(entry.target.id);
      if (link) { link.classList.add('here'); link.setAttribute('aria-current', 'location'); }
    }
  }, {rootMargin: '0px 0px -78% 0px', threshold: 0});
  for (const id of links.keys()) { const element = document.getElementById(id); if(element) observer.observe(element); }
})();
</script>
</body>
</html>
