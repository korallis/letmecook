{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "*.ts"
  ],
  "exclude": [
    "native-*.ts"
  ]
}
